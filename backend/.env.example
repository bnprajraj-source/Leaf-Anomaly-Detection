# Example environment variables for backend
# Copy this file to .env and fill in production values before deployment.

APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=leaf_anomaly_detection

# Replace with a secure random string in production
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@leafanomaly.com
SMTP_USE_TLS=true

# Request throttling
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
